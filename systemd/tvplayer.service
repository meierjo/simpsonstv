[Unit]
Description=Simpsons TV player
After=local-fs.target

[Service]
User=pi
Group=pi
WorkingDirectory=/home/pi/simpsonstv
ExecStart=/usr/bin/python3 /home/pi/simpsonstv/player.py
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=5
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target

