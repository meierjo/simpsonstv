[Unit]
Description=Simpsons TV touchscreen controls
After=local-fs.target tvplayer.service

[Service]
User=pi
Group=pi
SupplementaryGroups=input video
WorkingDirectory=/home/pi/simpsonstv
ExecStart=/usr/bin/python3 /home/pi/simpsonstv/touch_control.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

